# --- Database (Neon) -------------------------------------------------------
# Pooled connection — used by the app at runtime.
# In Neon this is the string WITH "-pooler" in the host.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Unpooled connection — used only for migrations, which need a real session.
# Same string WITHOUT "-pooler".
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# --- Session ---------------------------------------------------------------
# 32+ random characters. Anyone holding this can forge a login, so keep it
# secret and change it if it ever leaks. Rotating it signs everyone out.
SESSION_SECRET="replace-with-32-or-more-random-characters"

# --- Cron (optional) -------------------------------------------------------
# Set this and Vercel will send it as a bearer token on the daily class
# generation job, so nobody else can trigger it.
CRON_SECRET=""
